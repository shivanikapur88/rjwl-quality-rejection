<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-independent part of the Android app: API client, session, navigation abstractions and view-models.
       Plain net10.0 so it builds and unit-tests without the MAUI workload.
       Source recovered by decompiling the supplied Quality.Mobile.Core.dll (see docs/RECOVERY.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Quality.Core\Quality.Core.csproj" />
  </ItemGroup>
</Project>
