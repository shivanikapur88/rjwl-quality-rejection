<Project Sdk="Microsoft.NET.Sdk">
  <!-- Integration tests against a REAL SQL Server (not a substitute). Set QR_TEST_SQL to a connection string for a test
       server where the login may create and drop databases, e.g.
       QR_TEST_SQL="Server=localhost,14333;User Id=sa;Password=...;TrustServerCertificate=True"
       Without QR_TEST_SQL every test reports as skipped. See docs/TEST_EVIDENCE.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Quality.Api\Quality.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\db\*.sql" Link="db\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\seed\phenomena_seed.json" Link="db\seed\phenomena_seed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
