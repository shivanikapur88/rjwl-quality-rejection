<?xml version="1.0" encoding="UTF-8" ?>
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.SettingsPage" x:DataType="vm:SettingsViewModel" Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="16">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Server address" Style="{StaticResource Heading}" />
                    <Label Text="HTTPS address of the quality API, e.g. https://server:5001" Style="{StaticResource Secondary}" />
                    <Entry SemanticProperties.Description="Server address" Text="{Binding ServerUrl}" Keyboard="Url" Placeholder="https://" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Text="Save" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="1" Text="Test connection" Command="{Binding TestCommand}" Style="{StaticResource PrimaryButton}" />
                    </Grid>
                    <Border Style="{StaticResource SuccessBanner}" IsVisible="{Binding HasInfo}">
                        <Label Text="{Binding InfoMessage}" Style="{StaticResource SuccessText}" />
                    </Border>
                </VerticalStackLayout>
            </Border>
            <ctl:StatusBar />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Account" Style="{StaticResource Heading}" />
                    <Label Text="{Binding UserText}" Style="{StaticResource Body}" />
                    <Button Text="Sign out" Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}" IsVisible="{Binding IsSignedIn}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding VersionText}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</pages:AppPage>
