<?xml version="1.0" encoding="UTF-8" ?>
<!-- App design round (A3): everything scrolls (small phones reach Settings); shops are a BindableLayout, not a nested list.
     Inspectors: "Scan machine QR" is the primary action, then the shops. Supervisors/administrators: "Shift summary". -->
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.HomePage" x:DataType="vm:HomeViewModel" Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="16">
            <!-- Who is signed in -->
            <Border Style="{StaticResource HeaderCard}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Welcome}" Style="{StaticResource OnPrimaryTitle}" />
                    <Label Text="{Binding RoleText}" Style="{StaticResource OnPrimarySecondary}" />
                </VerticalStackLayout>
            </Border>
            <ctl:StatusBar />

            <!-- Inspectors: record a rejection -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding CanRecord}">
                <Button Text="Scan machine QR" Command="{Binding ScanCommand}" Style="{StaticResource HeroButton}" AutomationId="scan" />
                <Label Text="Or choose the shop" Style="{StaticResource Heading}" Margin="0,8,0,0" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Shops}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:ShopDto">
                            <Border Style="{StaticResource CardList}">
                                <Grid Style="{StaticResource NavRow}" ColumnDefinitions="*,Auto" MinimumHeightRequest="64">
                                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnShopTapped" /></Grid.GestureRecognizers>
                                    <Label Text="{Binding ShopName}" Style="{StaticResource Subheading}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="›" Style="{StaticResource Chevron}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Supervisors and administrators: the day's numbers -->
            <Button Text="Shift summary" Command="{Binding SummaryCommand}" Style="{StaticResource PrimaryButton}" IsVisible="{Binding CanReview}" />

            <!-- Records -->
            <Border Style="{StaticResource CardList}">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource NavRow}" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding MyEntriesCommand}" /></Grid.GestureRecognizers>
                        <Label Text="{Binding EntriesButtonText}" Style="{StaticResource Body}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource DividerLine}" />
                    <Grid Style="{StaticResource NavRow}" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CorrectionsCommand}" /></Grid.GestureRecognizers>
                        <Label Text="{Binding CorrectionsButtonText}" Style="{StaticResource Body}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Administrators -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAdmin}">
                <Label Text="Administration" Style="{StaticResource FieldLabel}" Margin="4,0" />
                <Border Style="{StaticResource CardList}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource NavRow}" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding AdminCommand}" /></Grid.GestureRecognizers>
                            <Label Text="Rejection phenomena" Style="{StaticResource Body}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" Style="{StaticResource Chevron}" />
                        </Grid>
                        <BoxView Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource NavRow}" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding AdminMachinesCommand}" /></Grid.GestureRecognizers>
                            <Label Text="Machines" Style="{StaticResource Body}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" Style="{StaticResource Chevron}" />
                        </Grid>
                        <BoxView Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource NavRow}" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding AdminUsersCommand}" /></Grid.GestureRecognizers>
                            <Label Text="Users" Style="{StaticResource Body}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="›" Style="{StaticResource Chevron}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Settings (server address, sign out) -->
            <Border Style="{StaticResource CardList}">
                <Grid Style="{StaticResource NavRow}" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SettingsCommand}" /></Grid.GestureRecognizers>
                    <Label Text="Settings and sign out" Style="{StaticResource Body}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="›" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</pages:AppPage>
