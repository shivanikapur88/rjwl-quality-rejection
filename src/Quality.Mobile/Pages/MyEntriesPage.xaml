<?xml version="1.0" encoding="UTF-8" ?>
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.MyEntriesPage" x:DataType="vm:MyEntriesViewModel" Title="Entries">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="10">
        <Label Text="{Binding Heading}" Style="{StaticResource H1}" />
        <ctl:StatusBar Grid.Row="1" />
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" IsVisible="{Binding IsIncomplete}">
            <Label Text="{Binding IncompleteNotice}" Style="{StaticResource Body}" FontSize="15" />
        </Border>
        <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <Grid>
                <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryRow">
                            <Border Style="{StaticResource Card}" Padding="14">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Line1}" Style="{StaticResource H2}" />
                                    <Label Text="{Binding Line2}" Style="{StaticResource Body}" FontSize="15" />
                                    <Label Text="{Binding Line3}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <Button Text="Load more" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,24" />
                    </CollectionView.Footer>
                </CollectionView>
                <Label Text="No entries yet." Style="{StaticResource Muted}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,40,0,0" IsVisible="{Binding IsEmpty}" />
            </Grid>
        </RefreshView>
    </Grid>
</pages:AppPage>
