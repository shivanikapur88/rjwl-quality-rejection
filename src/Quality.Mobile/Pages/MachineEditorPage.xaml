<?xml version="1.0" encoding="UTF-8" ?>
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.MachineEditorPage" x:DataType="vm:MachineEditorViewModel" Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="16">
            <ctl:StatusBar />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <VerticalStackLayout IsVisible="{Binding IsCreate}" Spacing="4">
                        <Label Text="Shop" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding Shops}" SelectedItem="{Binding SelectedShop, Mode=TwoWay}" Title="Select shop" />
                    </VerticalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding IsEdit}" Spacing="4">
                        <Label Text="Shop (cannot be changed)" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding FixedShopText}" Style="{StaticResource BodyStrong}" />
                    </VerticalStackLayout>
                    <Label Text="Machine code" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <Entry SemanticProperties.Description="Machine code" Text="{Binding Code}" MaxLength="30" Placeholder="e.g. GDC-05" />
                    <Label Text="Machine name" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <Entry SemanticProperties.Description="Machine name" Text="{Binding MachineName}" MaxLength="100" Placeholder="Name or description" />
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCreate}" MinimumHeightRequest="48" Margin="0,8,0,0">
                        <Label Text="Active" Style="{StaticResource Body}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsActive}" SemanticProperties.Description="Machine is active" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</pages:AppPage>
