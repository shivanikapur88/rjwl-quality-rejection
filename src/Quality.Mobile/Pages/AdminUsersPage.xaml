<?xml version="1.0" encoding="UTF-8" ?>
<!-- App design round: the filters are the list's header and scroll away (A4). -->
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.AdminUsersPage" x:DataType="vm:AdminUsersViewModel" Title="Users">
    <Grid RowDefinitions="Auto,*" Padding="12,8,12,0" RowSpacing="8">
        <ctl:StatusBar />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
            <CollectionView.Header>
                <VerticalStackLayout Spacing="8" Padding="0,0,0,8">
                    <Border Style="{StaticResource CardCompact}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Status" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" Title="Status" />
                            <SearchBar Text="{Binding SearchText}" SearchCommand="{Binding SearchCommand}" Placeholder="Search name, username or employee code" />
                            <Button Text="+ Add user" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="{Binding CountText}" Style="{StaticResource Secondary}" Margin="4,0" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:UserItem">
                    <Border Style="{StaticResource CardCompact}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding DisplayName}" Style="{StaticResource Subheading}" VerticalOptions="Center" />
                                <ctl:StatusChip Grid.Column="1" Text="{Binding StatusText}" VerticalOptions="Start" />
                            </Grid>
                            <Label Text="{Binding Line}" Style="{StaticResource Secondary}" />
                            <Label Text="{Binding RoleText}" Style="{StaticResource Body}" />
                            <Label Text="{Binding ShopsText}" Style="{StaticResource Secondary}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                                <Button Text="Edit" Style="{StaticResource SecondaryButton}" Clicked="OnEdit" />
                                <Button Grid.Column="1" Text="{Binding ToggleText}" Style="{StaticResource SecondaryButton}" Clicked="OnToggle" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer><BoxView HeightRequest="16" Color="Transparent" /></CollectionView.Footer>
        </CollectionView>
    </Grid>
</pages:AppPage>
