<?xml version="1.0" encoding="UTF-8" ?>
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.AdminUsersPage" x:DataType="vm:AdminUsersViewModel" Title="Users">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12" RowSpacing="8">
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
            <VerticalStackLayout Spacing="6">
                <Label Text="Status" Style="{StaticResource Muted}" />
                <Picker ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                <Button Text="+ Add user" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
                <SearchBar Text="{Binding SearchText}" SearchCommand="{Binding SearchCommand}" Placeholder="Search name, username or employee code" FontSize="17" />
            </VerticalStackLayout>
        </Border>
        <ctl:StatusBar Grid.Row="1" />
        <Label Grid.Row="2" Text="{Binding CountText}" Style="{StaticResource Muted}" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:UserItem">
                    <Border Style="{StaticResource Card}" Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding DisplayName}" Style="{StaticResource H2}" />
                                <Label Grid.Column="1" Text="{Binding StatusText}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            </Grid>
                            <Label Text="{Binding Line}" Style="{StaticResource Muted}" />
                            <Label Text="{Binding RoleText}" Style="{StaticResource Body}" FontSize="16" />
                            <Label Text="{Binding ShopsText}" Style="{StaticResource Muted}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,6,0,0">
                                <Button Text="Edit" Style="{StaticResource SmallButton}" Clicked="OnEdit" />
                                <Button Grid.Column="1" Text="{Binding ToggleText}" Style="{StaticResource SmallButton}" Clicked="OnToggle" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</pages:AppPage>
