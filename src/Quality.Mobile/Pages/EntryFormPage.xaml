<?xml version="1.0" encoding="UTF-8" ?>
<!-- App design round (A1): a one-line context header; the phenomenon list takes all the remaining height. Once a phenomenon
     is chosen, the list gives way to the chosen phenomenon ("Change" brings the list back), the quantity, optional remarks
     and Save, in a ScrollView that stays reachable with the keyboard open (the window resizes, see App.xaml.cs).
     Errors and "Try again" sit in one compact banner. -->
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.EntryFormPage" x:DataType="vm:EntryFormViewModel" Title="Rejection entry">
    <Grid RowDefinitions="Auto,Auto,*" Padding="12,8,12,12" RowSpacing="8">
        <!-- Context chosen in the previous steps, e.g. "GDC Shop › GDC-02 – Die casting press 2" -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="32">
            <Label Text="{Binding ContextText}" Style="{StaticResource ContextLine}" LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" />
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
        </Grid>

        <!-- Compact error banner; "Try again" when the phenomena list failed to load (a kept entry is restored then) -->
        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" Padding="12,8" IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Try again" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetryLoad}" Style="{StaticResource TertiaryButton}" VerticalOptions="Center" AutomationId="retry-phenomena" />
            </Grid>
        </Border>

        <!-- Step 1: choose the phenomenon (phenomena for THIS stage, loaded from the server) -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding IsChoosingPhenomenon}">
            <SearchBar SemanticProperties.Description="Search rejection phenomenon" x:Name="Search" Text="{Binding SearchText}" Placeholder="Search rejection phenomenon" />
            <Border Grid.Row="1" Style="{StaticResource CardList}">
                <CollectionView ItemsSource="{Binding Phenomena}" SelectionMode="Single" SelectedItem="{Binding SelectedPhenomenon, Mode=TwoWay}" SelectionChanged="OnPhenomenonSelected">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="0" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:PhenomenonDto">
                            <Grid Style="{StaticResource ListItem}" RowDefinitions="*,Auto" Padding="0">
                                <Label Text="{Binding PhenomenonName}" Style="{StaticResource Body}" Margin="16,14" VerticalOptions="Center" />
                                <BoxView Grid.Row="1" Style="{StaticResource DividerLine}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>

        <!-- Step 2: quantity, remarks, save -->
        <ScrollView Grid.Row="2" IsVisible="{Binding HasSelection}">
            <VerticalStackLayout Spacing="12" Padding="0,0,0,8">
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                        <Label Text="Rejection phenomenon" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Row="1" Text="{Binding SelectedPhenomenon.PhenomenonName}" Style="{StaticResource Heading}" />
                        <Button Grid.Column="1" Grid.RowSpan="2" Text="Change" Command="{Binding ChangePhenomenonCommand}" Style="{StaticResource TertiaryButton}" VerticalOptions="Center" AutomationId="change-phenomenon" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Rejected quantity (parts)" Style="{StaticResource FieldLabel}" />
                        <Grid ColumnDefinitions="64,*,64" ColumnSpacing="12">
                            <Button Text="−" Command="{Binding DecreaseCommand}" Style="{StaticResource StepperButton}" SemanticProperties.Description="One part less" AutomationId="qty-minus" />
                            <Entry SemanticProperties.Description="Quantity of rejected parts" Grid.Column="1" Text="{Binding QuantityText}" Style="{StaticResource QuantityEntry}" Keyboard="Numeric" MaxLength="4" AutomationId="quantity" />
                            <Button Grid.Column="2" Text="+" Command="{Binding IncreaseCommand}" Style="{StaticResource StepperButton}" SemanticProperties.Description="One part more" AutomationId="qty-plus" />
                        </Grid>
                        <Label Text="{Binding QuantityHint}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasQuantityError}" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="+ Add remarks" Command="{Binding AddRemarksCommand}" Clicked="OnAddRemarks" IsVisible="{Binding CanAddRemarks}" Style="{StaticResource TertiaryButton}" HorizontalOptions="Start" AutomationId="add-remarks" />
                <Border Style="{StaticResource Card}" Padding="16,12" IsVisible="{Binding IsRemarksOpen}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Remarks (optional)" Style="{StaticResource FieldLabel}" />
                        <Editor SemanticProperties.Description="Remarks" x:Name="RemarksEditor" Text="{Binding Remarks}" Placeholder="What did you see?" MaxLength="500" HeightRequest="96" AutoSize="Disabled" AutomationId="remarks" />
                        <Label Text="{Binding RemarksCounter}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                    <Button Text="Clear" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" AutomationId="clear" />
                    <Button Grid.Column="1" Text="Save entry" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" AutomationId="save" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</pages:AppPage>
