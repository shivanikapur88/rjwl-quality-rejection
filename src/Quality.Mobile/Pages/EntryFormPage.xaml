<?xml version="1.0" encoding="UTF-8" ?>
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.EntryFormPage" x:DataType="vm:EntryFormViewModel" Title="Rejection entry">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="12" RowSpacing="8">
        <!-- Context chosen in the previous steps -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" BackgroundColor="{StaticResource InfoSoft}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                <Label Text="Shop" Style="{StaticResource Muted}" /><Label Grid.Column="1" Text="{Binding ShopText}" FontAttributes="Bold" FontSize="16" />
                <Label Grid.Row="1" Text="Stage" Style="{StaticResource Muted}" /><Label Grid.Row="1" Grid.Column="1" Text="{Binding StageText}" FontAttributes="Bold" FontSize="16" />
                <Label Grid.Row="2" Text="Machine" Style="{StaticResource Muted}" /><Label Grid.Row="2" Grid.Column="1" Text="{Binding MachineText}" FontAttributes="Bold" FontSize="16" />
            </Grid>
        </Border>
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <ctl:StatusBar />
            <!-- Review fix: the phenomena list failed to load; try again without leaving the form (a kept entry is restored then). -->
            <Button Text="Try again" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetryLoad}" Style="{StaticResource SecondaryButton}" AutomationId="retry-phenomena" />
        </VerticalStackLayout>
        <SearchBar Grid.Row="2" Text="{Binding SearchText}" Placeholder="Search rejection phenomenon" FontSize="17" />
        <!-- Phenomena for THIS stage, loaded from the server -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Phenomena}" SelectionMode="Single" SelectedItem="{Binding SelectedPhenomenon, Mode=TwoWay}">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="4" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:PhenomenonDto">
                    <Grid Style="{StaticResource ListItem}" MinimumHeightRequest="56">
                        <Label Text="{Binding PhenomenonName}" Style="{StaticResource Body}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!-- Review + remarks + actions -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12">
            <VerticalStackLayout Spacing="8">
                <Label Text="Selected phenomenon" Style="{StaticResource Muted}" />
                <Label Text="{Binding SummaryText}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                <Label Text="Rejected quantity (parts)" Style="{StaticResource Muted}" />
                <Grid ColumnDefinitions="72,*,72" ColumnSpacing="8">
                    <Button Text="−" Command="{Binding DecreaseCommand}" Style="{StaticResource SecondaryButton}" FontSize="28" AutomationId="qty-minus" />
                    <Entry Grid.Column="1" Text="{Binding QuantityText}" Keyboard="Numeric" MaxLength="4" HorizontalTextAlignment="Center" FontSize="26" FontAttributes="Bold" AutomationId="quantity" />
                    <Button Grid.Column="2" Text="+" Command="{Binding IncreaseCommand}" Style="{StaticResource SecondaryButton}" FontSize="28" AutomationId="qty-plus" />
                </Grid>
                <Label Text="{Binding QuantityHint}" TextColor="{StaticResource Danger}" FontSize="13" IsVisible="{Binding HasQuantityError}" />
                <Editor Text="{Binding Remarks}" Placeholder="Remarks (optional)" MaxLength="500" HeightRequest="60" AutoSize="Disabled" />
                <Label Text="{Binding RemarksCounter}" Style="{StaticResource Muted}" HorizontalTextAlignment="End" />
                <Grid ColumnDefinitions="*,2*" ColumnSpacing="10">
                    <Button Text="Clear" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="1" Text="Save entry" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" AutomationId="save" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</pages:AppPage>
