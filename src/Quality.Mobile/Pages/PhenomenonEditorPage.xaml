<?xml version="1.0" encoding="UTF-8" ?>
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.PhenomenonEditorPage" x:DataType="vm:PhenomenonEditorViewModel" Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="16">
            <ctl:StatusBar />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <VerticalStackLayout IsVisible="{Binding IsCreate}" Spacing="4">
                        <Label Text="Shop" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding Shops}" SelectedItem="{Binding SelectedShop, Mode=TwoWay}" Title="Select shop" />
                        <Label Text="Inspection stage" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                        <Picker ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage, Mode=TwoWay}" Title="Select stage" />
                    </VerticalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding IsEdit}" Spacing="4">
                        <Label Text="Inspection stage (cannot be changed)" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding FixedStageText}" Style="{StaticResource BodyStrong}" />
                    </VerticalStackLayout>
                    <Label Text="Phenomenon name" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <Entry Text="{Binding Name}" MaxLength="200" Placeholder="Name" />
                    <Label Text="{Binding NameCounter}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCreate}" MinimumHeightRequest="48">
                        <Label Text="Active" Style="{StaticResource Body}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsActive}" SemanticProperties.Description="Phenomenon is active" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</pages:AppPage>
