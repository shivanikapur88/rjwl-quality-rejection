<?xml version="1.0" encoding="UTF-8" ?>
<!-- Round 2 (#4): rejected parts for one production day and shift. Counts only; no rejection percentage.
     App design round (A7): "›" is disabled on today; "1 entry" / "N entries"; cut lists say "Top 5". -->
<pages:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" xmlns:dto="clr-namespace:Quality.Core.Dtos;assembly=Quality.Core" xmlns:ctl="clr-namespace:Quality.Mobile.Controls" xmlns:pages="clr-namespace:Quality.Mobile.Pages" x:Class="Quality.Mobile.Pages.SummaryPage" x:DataType="vm:SummaryViewModel" Title="Shift summary">
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">
                <Grid ColumnDefinitions="56,*,56" ColumnSpacing="8">
                    <Button Text="‹" Command="{Binding PreviousDayCommand}" Style="{StaticResource StepperButton}" SemanticProperties.Description="Previous day" />
                    <Label Grid.Column="1" Text="{Binding DayText}" Style="{StaticResource Subheading}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Button Grid.Column="2" Text="›" Command="{Binding NextDayCommand}" Style="{StaticResource StepperButton}" SemanticProperties.Description="Next day" />
                </Grid>
                <Picker ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedShift, Mode=TwoWay}" Title="Shift" />
                <ctl:StatusBar />
                <Border Style="{StaticResource WarningBanner}" IsVisible="{Binding IsIncomplete}">
                    <Label Text="{Binding IncompleteNotice}" Style="{StaticResource WarningText}" />
                </Border>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding TotalText}" Style="{StaticResource Figure}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding EntriesText}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="By shop" Style="{StaticResource Heading}" Margin="0,8,0,0" IsVisible="{Binding HasShops}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Shops}" Spacing="8">
                    <BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:SummaryLine"><ctl:SummaryRow /></DataTemplate></BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding TopPhenomenaHeading}" Style="{StaticResource Heading}" Margin="0,8,0,0" IsVisible="{Binding HasTopPhenomena}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopPhenomena}" Spacing="8">
                    <BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:SummaryLine"><ctl:SummaryRow /></DataTemplate></BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding TopMachinesHeading}" Style="{StaticResource Heading}" Margin="0,8,0,0" IsVisible="{Binding HasTopMachines}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopMachines}" Spacing="8">
                    <BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:SummaryLine"><ctl:SummaryRow /></DataTemplate></BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding TopNote}" Style="{StaticResource Caption}" IsVisible="{Binding HasTopNote}" />
                <Label Text="Rejected parts recorded in the app. Reversed entries are not counted." Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</pages:AppPage>
