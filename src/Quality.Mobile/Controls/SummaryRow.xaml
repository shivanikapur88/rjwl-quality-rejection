<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Quality.Mobile.Core.ViewModels;assembly=Quality.Mobile.Core" x:Class="Quality.Mobile.Controls.SummaryRow" x:DataType="vm:SummaryLine">
    <Border Style="{StaticResource CardCompact}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Name}" Style="{StaticResource Subheading}" />
                <Label Text="{Binding Detail}" Style="{StaticResource Secondary}" />
            </VerticalStackLayout>
            <Label Grid.Column="1" Text="{Binding Value}" Style="{StaticResource MetricValue}" VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
